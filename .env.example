# Copy to .env and fill in. Never put real keys in this file.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare Workers AI: https://dash.cloudflare.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Kaggle: fill in KAGGLE_API_TOKEN (newer single token),
# or KAGGLE_USERNAME and KAGGLE_KEY (from a kaggle.json file)
KAGGLE_API_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional: Addis AI voices, https://platform.addisassistant.com
ADDIS_API_KEY=

# Optional: Groq, writes scripts and checks pictures, https://console.groq.com/keys
GROQ_API_KEY=

# Optional: show this repository's own film in the studio (1 = yes)
SHOW_REPO_FILM=

# Optional: Hugging Face
HF_TOKEN=

# Optional, paid: moving clips in minutes instead of hours (wavespeed.ai, API keys page). About $0.24 a clip.
WAVESPEED_API_KEY=
