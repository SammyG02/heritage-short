{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "title", "logline", "theme", "language", "audience", "intent", "style_block", "people", "models", "voices", "references", "video", "music", "mix", "shots", "end_card"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$", "description": "Names the folder under outputs/"},
    "version": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "approved", "sample"]},
    "title": {"$ref": "#/$defs/localised"},
    "logline": {"$ref": "#/$defs/text"},
    "theme": {"$ref": "#/$defs/text"},
    "language": {"enum": ["am", "en"], "description": "Main narration language"},
    "audience": {"$ref": "#/$defs/text"},
    "intent": {"$ref": "#/$defs/text"},
    "style_block": {"$ref": "#/$defs/text", "description": "Added to every image prompt"},
    "people": {"type": "object", "additionalProperties": false, "required": ["real_people", "statement"],
      "properties": {"real_people": {"const": false, "description": "No real face, likeness or voice is shown or cloned"},
        "based_on_real_people": {"type": "boolean", "description": "The story tells real events; generation stays locked until consent is recorded"},
        "consent": {"enum": ["pending", "recorded"], "description": "recorded only when ETHICS.md holds the consent"}, "statement": {"$ref": "#/$defs/text"}}},
    "models": {"type": "object", "additionalProperties": false, "required": ["tts", "image", "video", "music"],
      "properties": {"tts": {"$ref": "#/$defs/text"}, "image": {"$ref": "#/$defs/text"}, "video": {"$ref": "#/$defs/text"}, "music": {"$ref": "#/$defs/text"}}},
    "voices": {"type": "object", "minProperties": 1, "propertyNames": {"enum": ["am", "en"]},
      "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["voice", "style"],
        "properties": {"voice": {"$ref": "#/$defs/text"}, "style": {"$ref": "#/$defs/text"}, "model": {"$ref": "#/$defs/text", "description": "Overrides models.tts for this language, for example when a daily quota is used up"}}}},
    "references": {"type": "object", "minProperties": 1,
      "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["prompt", "seeds", "chosen_seed", "reason"],
        "properties": {"prompt": {"$ref": "#/$defs/text"}, "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
          "chosen_seed": {"type": "integer"}, "reason": {"type": "string"}}}},
    "video": {"type": "object", "additionalProperties": false, "required": ["fps", "frames", "steps", "guidance", "negative_prompt"],
      "properties": {"fps": {"const": 24}, "frames": {"type": "integer", "minimum": 17, "maximum": 121, "description": "4n + 1"},
        "steps": {"type": "integer", "minimum": 4, "maximum": 50}, "guidance": {"type": "number"}, "negative_prompt": {"type": "string"}}},
    "music": {"type": "object", "additionalProperties": false, "required": ["caption", "bpm", "key", "duration_s", "seeds", "chosen_seed", "reason", "cues"],
      "properties": {"caption": {"$ref": "#/$defs/text"}, "bpm": {"type": "integer", "minimum": 40, "maximum": 160}, "key": {"$ref": "#/$defs/text"},
        "duration_s": {"type": "number", "minimum": 10, "maximum": 120}, "seeds": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "integer"}},
        "chosen_seed": {"type": "integer"}, "reason": {"type": "string"},
        "cues": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["shot", "action", "note"],
          "properties": {"shot": {"$ref": "#/$defs/text"}, "action": {"enum": ["start", "lower", "lift", "end"]}, "note": {"$ref": "#/$defs/text"}}}}}},
    "mix": {"type": "object", "additionalProperties": false, "required": ["duck_threshold", "duck_ratio", "duck_attack_ms", "duck_release_ms", "target_lufs", "true_peak_db", "music_lufs"],
      "properties": {"duck_threshold": {"type": "number"}, "duck_ratio": {"type": "number"}, "duck_attack_ms": {"type": "number"},
        "duck_release_ms": {"type": "number"}, "target_lufs": {"type": "number"}, "true_peak_db": {"type": "number"}, "music_lufs": {"type": "number"}}},
    "shots": {"type": "array", "minItems": 8, "maxItems": 12, "items": {"$ref": "#/$defs/shot"}},
    "end_card": {"type": "object", "additionalProperties": false, "required": ["duration_s", "lines"],
      "properties": {"duration_s": {"type": "number", "minimum": 2, "maximum": 4},
        "lines": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/text"}, "contains": {"pattern": "AI"}}}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "localised": {"type": "object", "minProperties": 1, "propertyNames": {"enum": ["am", "en"]}, "additionalProperties": {"$ref": "#/$defs/text"}},
    "shot": {"type": "object", "additionalProperties": false,
      "required": ["id", "reason", "duration_s", "size", "references", "image_prompt", "motion_prompt", "seed", "ken_burns", "narration"],
      "properties": {
        "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "reason": {"$ref": "#/$defs/text", "description": "Why this shot exists"},
        "duration_s": {"type": "number", "minimum": 2, "maximum": 12, "description": "Minimum length; narration may extend it"},
        "size": {"enum": ["extreme wide", "wide", "medium", "medium close-up", "close-up", "insert"]},
        "references": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
        "image_prompt": {"$ref": "#/$defs/text"},
        "motion_prompt": {"$ref": "#/$defs/text", "description": "Motion and camera only"},
        "seed": {"type": "integer"},
        "ken_burns": {"enum": ["in", "out", "left", "right", "up", "down"]},
        "narration": {"type": "object", "required": ["en"], "propertyNames": {"enum": ["am", "en"]}, "additionalProperties": {"$ref": "#/$defs/text"},
          "description": "Per language. English is also the subtitle text"}
      }}
  }
}
