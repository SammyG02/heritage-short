{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "status", "title", "logline", "theme", "language", "audience", "intent", "style_block", "people", "models", "voices", "references", "video", "music", "mix", "shots", "end_card"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$", "description": "Names the folder under outputs/"},
    "version": {"type": "integer", "minimum": 1},
    "picture_size": {"enum": ["full", "light"], "description": "light: shots that will become 480p clips are drawn small, about a third of the price. Default full"},
    "approvals": {"type": "object", "additionalProperties": false, "description": "What a person approved, by content hash; a change cancels it",
      "properties": {"script": {"type": "object"}, "voice": {"type": "object"}, "picture": {"type": "object"}, "clip": {"type": "object"}}},
    "services": {"type": "object", "additionalProperties": false, "properties": {"pictures": {"enum": ["cloudflare", "kaggle"]}, "animate": {"enum": ["kaggle", "wavespeed"], "description": "Who makes the moving clips; default kaggle"}, "wavespeed": {"enum": ["fast", "standard"], "description": "WaveSpeed quality: fast is a third of the price"}}, "description": "Where this film's shots are drawn and animated"},
    "status": {"enum": ["draft", "approved", "sample"]},
    "title": {"$ref": "#/$defs/localised"},
    "logline": {"$ref": "#/$defs/text"},
    "wide_from_vertical": {"type": "boolean", "description": "Default true: only vertical pictures are drawn and the wide film is made from the vertical one, the same frames with blurred sides"},
    "story": {"$ref": "#/$defs/text", "description": "What the person told, word for word; the script was written from it"},
    "theme": {"$ref": "#/$defs/text"},
    "language": {"enum": ["am", "en"], "description": "Main narration language"},
    "audience": {"$ref": "#/$defs/text"},
    "intent": {"$ref": "#/$defs/text"},
    "style_block": {"$ref": "#/$defs/text", "description": "Added to every image prompt"},
    "people": {"type": "object", "additionalProperties": false, "required": ["real_people", "statement"],
      "properties": {"real_people": {"type": "boolean", "description": "true only when a character is drawn from a photo its person agreed to; otherwise no real face, likeness or voice is used"},
        "based_on_real_people": {"type": "boolean", "description": "The story tells real events; generation stays locked until consent is recorded"},
        "consent": {"enum": ["pending", "recorded"], "description": "recorded only when the consent is written in ETHICS.md or consent_record"},
        "consent_record": {"type": "string", "description": "Who agreed, when, how and to what, in the filmmaker's words"},
        "people_agreed": {"type": "array", "description": "Each person in a true story, by role: what they agreed to, and when and how",
          "items": {"type": "object", "additionalProperties": false, "required": ["role", "story", "likeness", "words", "how"],
            "properties": {"role": {"type": "string"}, "story": {"type": "boolean"}, "likeness": {"type": "boolean"}, "words": {"type": "boolean"}, "photo": {"type": "boolean"}, "how": {"type": "string"}}}},
        "ai_services": {"type": "object", "additionalProperties": false, "description": "For a true story: which AI services its people agreed to, one by one; an unticked one is never called",
          "properties": {"google": {"type": "boolean"}, "cloudflare": {"type": "boolean"}, "addis": {"type": "boolean"}, "kaggle": {"type": "boolean"}, "wavespeed": {"type": "boolean"}, "groq": {"type": "boolean"}}},
        "addis_consent": {"type": "string", "description": "That the people in a true story agreed to its text going to Addis AI, which may train on it"}, "statement": {"$ref": "#/$defs/text"}}},
    "models": {"type": "object", "additionalProperties": false, "required": ["tts", "image", "video", "music"],
      "properties": {"tts": {"$ref": "#/$defs/text"}, "tts_fallbacks": {"type": "array", "items": {"$ref": "#/$defs/text"}, "description": "Tried in order when the TTS model is out of quota or down"}, "image": {"$ref": "#/$defs/text"}, "video": {"$ref": "#/$defs/text"}, "music": {"$ref": "#/$defs/text"}}},
    "voices": {"type": "object", "minProperties": 1, "propertyNames": {"enum": ["am", "en"]},
      "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["voice", "style"],
        "properties": {"engine": {"enum": ["gemini", "addis", "omnivoice"], "description": "Which service speaks. Changing it remakes every line, so one film never mixes services"}, "voice": {"$ref": "#/$defs/text"}, "style": {"$ref": "#/$defs/text"}, "model": {"$ref": "#/$defs/text", "description": "Overrides models.tts for this language, for example when a daily quota is used up"},
          "characters": {"type": "object", "description": "Stock voices for quoted words, by character name", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["voice", "style"],
            "properties": {"voice": {"$ref": "#/$defs/text"}, "style": {"$ref": "#/$defs/text"}}}}}}},
    "references": {"type": "object", "minProperties": 1,
      "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["prompt", "seeds", "chosen_seed", "reason"],
        "properties": {"prompt": {"$ref": "#/$defs/text"}, "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
          "chosen_seed": {"type": "integer"}, "reason": {"type": "string"},
          "look": {"$ref": "#/$defs/text", "description": "Fixed description repeated in every shot that shows this reference, so it cannot drift"},
          "from": {"type": "string", "description": "Another reference this one is drawn from, for example the same person older"},
          "photo": {"type": "object", "additionalProperties": false, "required": ["person"], "description": "Drawn from a photo of this person (a role in people_agreed); the photo stays on the computer and out of git",
            "properties": {"person": {"type": "string"}}}}}},
    "video": {"type": "object", "additionalProperties": false, "required": ["fps", "frames", "steps", "guidance", "negative_prompt"],
      "properties": {"fps": {"const": 24}, "frames": {"type": "integer", "minimum": 17, "maximum": 121, "description": "4n + 1"},
        "steps": {"type": "integer", "minimum": 4, "maximum": 50}, "guidance": {"type": "number"}, "negative_prompt": {"type": "string"},
        "max_gpu_hours": {"type": "number", "minimum": 0, "maximum": 8, "description": "Most GPU time one motion job may plan to use"}}},
    "music": {"type": "object", "additionalProperties": false, "required": ["caption", "bpm", "key", "duration_s", "seeds", "chosen_seed", "reason", "cues"],
      "properties": {"caption": {"$ref": "#/$defs/text"}, "bpm": {"type": "integer", "minimum": 40, "maximum": 160}, "key": {"$ref": "#/$defs/text"},
        "duration_s": {"type": "number", "minimum": 10, "maximum": 120}, "seeds": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "integer"}},
        "chosen_seed": {"type": "integer"}, "reason": {"type": "string"},
        "cues": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["shot", "action", "note"],
          "properties": {"shot": {"$ref": "#/$defs/text"}, "action": {"enum": ["start", "lower", "lift", "end"]}, "note": {"$ref": "#/$defs/text"}}}}}},
    "mix": {"type": "object", "additionalProperties": false, "required": ["duck_threshold", "duck_ratio", "duck_attack_ms", "duck_release_ms", "target_lufs", "true_peak_db", "music_lufs"],
      "properties": {"duck_threshold": {"type": "number"}, "duck_ratio": {"type": "number"}, "duck_attack_ms": {"type": "number"},
        "duck_release_ms": {"type": "number"}, "target_lufs": {"type": "number"}, "true_peak_db": {"type": "number"}, "music_lufs": {"type": "number"}}},
    "shots": {"type": "array", "minItems": 8, "maxItems": 12, "items": {"$ref": "#/$defs/shot"}},
    "end_card": {"type": "object", "additionalProperties": false, "required": ["duration_s", "lines"],
      "properties": {"duration_s": {"type": "number", "minimum": 2, "maximum": 4},
        "lines": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/text"}, "contains": {"pattern": "AI"}}}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "localised": {"type": "object", "minProperties": 1, "propertyNames": {"enum": ["am", "en"]}, "additionalProperties": {"$ref": "#/$defs/text"}},
    "shot": {"type": "object", "additionalProperties": false,
      "required": ["id", "reason", "duration_s", "size", "references", "image_prompt", "motion_prompt", "seed", "ken_burns", "narration"],
      "properties": {
        "id": {"type": "string", "pattern": "^s[0-9]{2}$"},
        "reason": {"$ref": "#/$defs/text", "description": "Why this shot exists"},
        "duration_s": {"type": "number", "minimum": 2, "maximum": 12, "description": "Minimum length; narration may extend it"},
        "size": {"enum": ["extreme wide", "wide", "medium", "medium close-up", "close-up", "insert"]},
        "references": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
        "image_prompt": {"$ref": "#/$defs/text"},
        "motion_prompt": {"$ref": "#/$defs/text", "description": "Motion and camera only"},
        "seed": {"type": "integer"},
        "emotion": {"$ref": "#/$defs/text", "description": "What the characters visibly feel; added to the picture and the motion prompt"},
        "voice_emotion": {"$ref": "#/$defs/text", "description": "Added to the voice style for this line"},
        "transition": {"type": "object", "additionalProperties": false, "required": ["type", "reason"], "description": "How this shot arrives from the one before",
          "properties": {"type": {"enum": ["cut", "fade", "dissolve", "fadeblack", "fadewhite", "smoothleft", "smoothright", "smoothup", "circleopen"]},
            "seconds": {"type": "number", "minimum": 0.2, "maximum": 1.5}, "reason": {"$ref": "#/$defs/text"}}},
        "takes": {"type": "object", "additionalProperties": false, "description": "How many times each format was redrawn; moves that format's seed only",
          "properties": {"9x16": {"type": "integer", "minimum": 0}, "16x9": {"type": "integer", "minimum": 0}, "clip": {"type": "integer", "minimum": 0, "description": "Animate again: moves the clip's seed only"}}},
        "motion": {"enum": ["clip", "camera"], "description": "camera: a slow move on the picture, no GPU"},
        "animate": {"enum": ["kaggle", "wavespeed"], "description": "Who makes this shot's clip; default the film's (services.animate), else kaggle"},
        "tts_model": {"type": "string", "description": "Overrides the TTS model for this shot, for example a line made before a quota ran out"},
        "quote_voice": {"type": "string", "description": "Character who speaks the quoted words; needs a voice in voices.<lang>.characters"},
        "ken_burns": {"enum": ["in", "out", "left", "right", "up", "down"]},
        "narration": {"type": "object", "required": ["en"], "propertyNames": {"enum": ["am", "en"]}, "additionalProperties": {"$ref": "#/$defs/text"},
          "description": "Per language. English is also the subtitle text"}
      }}
  }
}
